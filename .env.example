# NEAR AI Cloud key for the private bookkeeper (server-side only, never shipped to the browser)
NEARAI_API_KEY=
# Testnet relayer that pays gas for freelancers and creates their accounts. It must be the
# parent of their accounts (<handle>.nearvoice.testnet), so it is nearvoice.testnet itself.
RELAYER_ACCOUNT=nearvoice.testnet
RELAYER_KEY=
# Daily budget of private-model requests for the whole deployment
AI_DAILY_REQUESTS=500
