{
  "name": "nearvoice",
  "private": true,
  "version": "0.1.0",
  "description": "Nearvoice: private invoices paid in stablecoins on NEAR. Gasless for freelancers, TEE-verified AI bookkeeping, revenue splits, cross-chain payment quotes.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.2.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "biome lint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "ignoredBuiltDependencies": ["@biomejs/biome", "secp256k1"]
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "24.9.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "near-api-js": "7.3.1",
    "@nearvoice/core": "workspace:*"
  }
}
